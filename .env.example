# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AdSense (신청 승인 후 발급되는 publisher id, ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# 승인 후 AdSense에서 생성한 광고 단위(슬롯)의 ID. 비워두면 광고 영역이
# 자동으로 숨겨지므로 승인 전에 미리 배포해도 안전합니다.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# Google Analytics 4 (선택) - GA4 속성의 측정 ID, G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
